{
    "extends": [
        "@exabyte-io/eslint-config"
    ],
    "ignorePatterns": [
        "dist/",
        "src/standalone/stubs/",
        "*.d.ts"
    ],
    "plugins": [
        "react-hooks"
    ],
    "rules": {
        "import/no-extraneous-dependencies": "off",
        "import/no-unresolved": "off",
        "import/no-cycle": "off",
        "import/export": "off",
        "react/jsx-props-no-spreading": "off",
        "react/no-array-index-key": "off",
        "@typescript-eslint/no-empty-function": "off",
        "react-hooks/exhaustive-deps": "warn",
        "default-param-last": "off"
    },
    "overrides": [
        {
            "files": ["tests/*.tests.ts"],
            "rules": {
                // `tests/` has its own package.json (for Cypress's deps), which makes
                // `import/no-relative-packages` treat `../src/...` as crossing a package
                // boundary and suggest `@mat3ra/job-designer/src/...` instead. But these
                // node:test unit tests run via the root package's own `npm test`
                // (`node --test tests/*.tests.ts`), resolving imports as plain relative
                // paths - `@mat3ra/job-designer` isn't installed under tests/node_modules
                // (nor under the root's own), so the rule's suggested fix doesn't resolve.
                "import/no-relative-packages": "off"
            }
        }
    ],
    "settings": {
        "import/resolver": {
            "node": {
                "extensions": [
                    ".js",
                    ".jsx",
                    ".ts",
                    ".tsx"
                ]
            }
        }
    }
}
